amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Builtins.pkl"

exclude = List(".zig-cache/**", "zig-out/**", ".cache/**")

local linters = new Mapping<String, Step> {
  ["zig-fmt"] {
    glob = List("build.zig", "build.zig.zon", "src/**/*.zig", "tests/**/*.zig")
    check = "zig fmt --check {{files}}"
    fix = "zig fmt {{files}}"
  }

  ["clang-format"] = (Builtins.clang_format) {
    glob = List("src/**/*.c", "src/**/*.h")
  }

  ["shfmt"] = Builtins.shfmt
  ["mise"] = Builtins.mise

  ["check-ast"] {
    glob = List("src/**/*.zig")
    check = "ast-grep scan {{files}}"
  }

  ["check-complexity"] {
    glob = List("src/**/*.zig", "src/**/*.c", "src/**/*.h")
    check = "bash scripts/check-complexity.sh {{files}}"
  }

  ["check-dup"] {
    glob = List("src/**/*.zig", "src/**/*.c", "src/**/*.h")
    check = "jscpd --config .jscpd.json"
  }

  ["check-typos"] {
    glob = List("src/**", "scripts/**", "build.zig", "README.md", "CODING_STANDARDS.md", "GLOSSARY.md", "AGENTS.md")
    check = "typos {{files}}"
  }

  ["prettier"] = (Builtins.prettier) {
    glob = List("**/*.json")
  }

  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["newlines"] = Builtins.newlines
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["detect-private-key"] = Builtins.detect_private_key
  ["check-shebang-scripts-are-executable"] = Builtins.check_shebang_scripts_are_executable
  ["check-executables-have-shebangs"] = Builtins.check_executables_have_shebangs
  ["check-case-conflict"] = Builtins.check_case_conflict
  ["check-symlinks"] = Builtins.check_symlinks
}

local pre_push_guard = new Step {
  stdin = "{{hook_stdin}}"
  shell = "bash -o errexit -c"
  check = #"""
    set -euo pipefail

    is_null_oid() {
      [[ "${1:-}" =~ ^0{40}$ ]]
    }

    is_force_push() {
      local local_oid="$1"
      local remote_oid="$2"

      if is_null_oid "${remote_oid}" || is_null_oid "${local_oid}"; then
        return 1
      fi

      if git merge-base --is-ancestor "${remote_oid}" "${local_oid}" 2>/dev/null; then
        return 1
      fi
      return 0
    }

    while read -r local_ref local_oid remote_ref remote_oid; do
      [ -z "${local_ref:-}" ] && continue

      if [ "${remote_ref}" = "refs/heads/main" ] && is_force_push "${local_oid}" "${remote_oid}"; then
        echo "ERROR [hk pre-push]: Force-pushing to 'main' is prohibited." >&2
        exit 1
      fi
    done
  """#
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "patch-file"
    steps = linters
  }

  ["commit-msg"] {
    steps {
      ["check_conventional_commit"] = Builtins.check_conventional_commit
    }
  }

  ["pre-push"] {
    steps {
      ["guard-push"] = pre_push_guard
    }
  }

  ["check"] {
    steps = linters
  }

  ["fix"] {
    fix = true
    steps = linters
  }
}
